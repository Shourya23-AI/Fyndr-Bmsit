# Where the Fyndr server lives. Leave empty in dev (Vite forwards /api to http://localhost:3000)
# and when the server also serves this build. Example for a separate host: https://fyndr.onrender.com
VITE_API_BASE=
# Dev only: change if your server runs on another port.
VITE_DEV_API=http://localhost:3000

# Optional. Normally Firebase settings come from the server (/api/firebase-config), as on the old site.
# Fill these only if you host the front end without the server.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
